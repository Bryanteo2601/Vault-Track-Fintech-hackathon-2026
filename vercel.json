{
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "npm install -g pnpm && pnpm install",
  "framework": "expo",
  "outputDirectory": "dist",
  "env": [
    "FIREBASE_API_KEY",
    "FIREBASE_AUTH_DOMAIN",
    "FIREBASE_PROJECT_ID",
    "FIREBASE_STORAGE_BUCKET",
    "FIREBASE_MESSAGING_SENDER_ID",
    "FIREBASE_APP_ID",
    "FIREBASE_MEASUREMENT_ID",
    "GEMINI_API_KEY",
    "NODE_ENV",
    "EXPO_PORT"
  ],
  "functions": {
    "api/**/*.ts": {
      "memory": 3008,
      "maxDuration": 60
    }
  },
  "regions": ["sfo1"],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
